{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make lint)",
      "Bash(make lint *)",
      "Bash(make -C ../.. lint)",
      "Bash(make -C ../.. lint *)",
      "Bash(make clean)",
      "Bash(make defaultconfig)",
      "Bash(make clean defaultconfig)",
      "Bash(make setup-dbs)",
      "Bash(make setup-dbs *)",
      "Bash(make setup-apps *)",
      "Bash(make test-apps *)",
      "Bash(make screenshot-apps *)",
      "Bash(make stop-apps *)",
      "Bash(make stop-dbs)",
      "Bash(make stop-dbs *)",
      "Bash(go run ./ops/cmd/sampletool *)",
      "Bash(go test ./ops/...)",
      "Bash(go test * ./ops/...)",
      "Bash(go vet ./ops/...)",
      "Bash(multipass list)",
      "Bash(multipass list *)",
      "Bash(multipass info *)",
      "Bash(multipass exec *)",
      "Bash(multipass shell *)",
      "Bash(multipass transfer *)"
    ],
    "deny": [
      "Bash(make stop-all)",
      "Bash(make stop-all *)",
      "Bash(make * stop-all)",
      "Bash(make * stop-all *)",
      "Bash(multipass delete --all)",
      "Bash(multipass delete --all *)",
      "Bash(multipass delete * --all)",
      "Bash(multipass delete * --all *)"
    ]
  }
}
